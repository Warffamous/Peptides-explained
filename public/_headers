# Cache rules for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# HTML keeps the host default (revalidate on every visit), so a new deploy shows at once.

# The one stylesheet: every page links it with its content hash (/styles/site.css?v=<hash>,
# src/lib/site-css.ts), so a changed stylesheet always has a new URL.
/styles/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own assets (scripts, images): content-hashed file names.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: stable file names (scripts/sync-fonts.mjs), so a long cache but not immutable.
/fonts/*
  Cache-Control: public, max-age=2592000
