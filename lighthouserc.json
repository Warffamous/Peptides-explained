{
  "$comment": "Performance budget enforced in CI: Lighthouse >= 95 on all four categories, mobile emulation with simulated throttling, for every design system.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/en/",
        "http://localhost/en/compounds/bpc-157/",
        "http://localhost/en/compounds/semaglutide/",
        "http://localhost/en/safety/warning-signs/",
        "http://localhost/a/en/compounds/bpc-157/",
        "http://localhost/b/en/compounds/bpc-157/",
        "http://localhost/c/en/compounds/bpc-157/",
        "http://localhost/c/en/safety/sterile-technique/",
        "http://localhost/nl/compounds/bpc-157/"
      ],
      "settings": { "formFactor": "mobile", "throttlingMethod": "simulate", "skipAudits": ["is-crawlable", "canonical"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
