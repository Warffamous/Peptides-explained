---
/**
 * Compound page: localised prose (src/content/compounds/<locale>/<slug>.mdx) joined with
 * locale-independent facts (src/data/compounds/<slug>.yaml). Fixed structure, beginner first:
 * title + status badge · at a glance · 1 the 30-second version · review line · page photo
 * (beside the title on wide screens) · evidence profile, sequence, technical details · 2–8 the
 * MDX sections in fixed order · 9 sources.
 */
import { render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { mdxComponents } from '../../../components/mdx';
import EvidenceGrade from '../../../components/mdx/EvidenceGrade.astro';
import SequenceView from '../../../components/mdx/SequenceView.astro';
import AtAGlance from '../../../components/layout/AtAGlance.astro';
import StopStrip from '../../../components/layout/StopStrip.astro';
import FactSheet from '../../../components/layout/FactSheet.astro';
import ReadingTools from '../../../components/layout/ReadingTools.astro';
import InDetail from '../../../components/mdx/InDetail.astro';
import ThemeOnly from '../../../components/ui/ThemeOnly.astro';
import Pictogram from '../../../components/ui/Pictogram.astro';
import { BUILT_LOCALES } from '../../../lib/config';
import { compoundDataMap, resolveCompound, alternatesFor } from '../../../lib/content';
import { webPage } from '../../../lib/jsonld';
import { t, tr } from '../../../lib/i18n';
import { formatNumber } from '../../../lib/format';
import { mdxToPlain, readingMinutes, wordCount } from '../../../lib/readability';
import { COMPOUND_SECTIONS } from '../../../schemas/vocab';

export async function getStaticPaths() {
  const data = await compoundDataMap();
  const out = [];
  for (const loc of BUILT_LOCALES) {
    for (const slug of data.keys()) {
      if (await resolveCompound(loc.code, slug)) out.push({ params: { locale: loc.code, slug } });
    }
  }
  return out;
}

const { locale, slug } = Astro.params as { locale: string; slug: string };
Astro.locals.locale = locale;
const data = (await compoundDataMap()).get(slug)!;
const { entry, fallback } = (await resolveCompound(locale, slug))!;
const page = entry.data;
const { Content, remarkPluginFrontmatter: rpf } = await render(entry);

// Source list: inline citations first (in order of appearance), then the sources behind the
// data tables (studies, regulatory rows, sequence, product labels) so every table row links to one.
const citations: string[] = [...(rpf.citations ?? [])];
const add = (id?: string) => { if (id && !citations.includes(id)) citations.push(id); };
data.studies.forEach((s) => add(s.source));
data.regulatory.forEach((r) => r.sources.forEach(add));
add(data.sequence?.source);
add(data.molecular.smiles_source);
data.authorised_products.forEach((p) => add(p.label_source));
// The stop strip and the fact sheet are rendered outside the MDX: their sources join the list too.
page.glance.stop_signs?.forEach((s) => s.sources.forEach(add));
page.glance.facts.forEach((f) => f.sources.forEach(add));
const citeIndex = new Map(citations.map((id, i) => [id, i + 1]));
Astro.locals.compound = { slug, locale, data, page, citeIndex };

const key = `compounds/${slug}`;
const authorised = data.category === 'authorised' || data.category === 'authorised-elsewhere';
const sectionsPresent = (COMPOUND_SECTIONS as readonly string[]).filter((s) => entry.body?.includes(`<Section id="${s}">`));
const sectionTitle = (s: string) => t(locale, `compound.sections.${authorised && (s === 'mechanism' || s === 'harm-reduction') ? `${s}Authorised` : s}`);
// "Less text, more visuals": pages whose depth sits in "In detail" folds get the reading tools
// ("Open all details"), a folded source list, and a reading time for the short version too.
const hasFolds = entry.body?.includes('<InDetail') ?? false;
const toc = [
  { id: 'at-a-glance', text: t(locale, 'beginner.glance.title') },
  ...(page.glance.stop_signs ? [{ id: 'stop-strip', text: t(locale, 'beginner.stop.title') }] : []),
  { id: 'summary', text: t(locale, 'compound.sections.thirty-second') },
  { id: `grade-${slug}`, text: t(locale, 'evidence.title') },
  { id: 'technical', text: t(locale, 'beginner.technical.title') },
  ...sectionsPresent.map((s) => ({ id: s, text: sectionTitle(s) })),
  { id: 'sources', text: t(locale, 'compound.sections.sources') },
];
const trail = [
  { key: 'compounds', label: t(locale, 'compound.index.title') },
  { key, label: data.names.common },
];
const badgeKey = {
  authorised: 'compound.authorised.badge',
  'authorised-elsewhere': 'compound.authorised.badgeElsewhere',
  investigational: 'compound.investigationalBadge',
  experimental: 'compound.experimentalBadge',
  'not-a-peptide': 'compound.notPeptideBadge',
}[data.category];
const about = authorised
  ? { '@type': 'Drug', name: data.names.common, ...(data.names.inn ? { nonProprietaryName: data.names.inn } : {}), ...(data.names.brands.length ? { alternateName: data.names.brands } : {}), prescriptionStatus: 'PrescriptionOnly' }
  : { '@type': 'ChemicalSubstance', name: data.names.common, ...(data.names.other.length ? { alternateName: data.names.other } : {}) };
const alternates = fallback ? [] : await alternatesFor(key);
// Chemical formula with element counts as subscripts (input is validated to letters and digits).
const formula = data.molecular.formula && /^[A-Za-z0-9()]+$/.test(data.molecular.formula) ? data.molecular.formula.replace(/(\d+)/g, '<sub>$1</sub>') : null;
// Technical details (names, class, formula, mass): one list, shown open or inside the "In detail" fold.
type TechFact = { label: string; value: string; qty?: boolean; formula?: boolean };
const techFacts: TechFact[] = [
  ...(data.names.full ? [{ label: t(locale, 'compound.names.full'), value: data.names.full }] : []),
  ...(data.names.inn ? [{ label: t(locale, 'compound.names.inn'), value: data.names.inn }] : []),
  ...(data.names.other.length > 0 ? [{ label: t(locale, 'compound.names.other'), value: data.names.other.join(', ') }] : []),
  ...(data.names.brands.length > 0 ? [{ label: t(locale, 'compound.names.brands'), value: data.names.brands.join(', ') }] : []),
  { label: t(locale, 'compound.names.class'), value: t(locale, `vocab.class.${data.class}`) },
  { label: t(locale, 'compound.names.bodySystems'), value: data.body_systems.map((b) => t(locale, `vocab.bodySystem.${b}`)).join(', ') },
  ...(formula ? [{ label: t(locale, 'compound.names.formula'), value: formula, qty: true, formula: true }] : []),
  ...(data.molecular.mass_da ? [{ label: t(locale, 'compound.names.mass'), value: `${formatNumber(locale, data.molecular.mass_da)} Da`, qty: true }] : []),
];
// Words that live in component props rather than between tags: section leads, figure titles and
// detail lines, key numbers, comparison and timeline labels (question="…", title="…", label: "…").
const propText = (src: string) =>
  [...src.matchAll(/\b(?:question|title|detail|label|value|who|text|axis|a|b)\s*[=:]\s*"([^"]*)"/g)].map((m) => m[1]).join(' ');
// Explainers carry their words in i18n: the title, step captions and summary are always visible.
const explainerText = (src: string) =>
  [...src.matchAll(/<Explainer\s+id="([^"]+)"/g)]
    .map((m) => {
      const x = tr<{ title: string; steps: string[]; summary: string }>(locale, `explainers.${m[1]}`);
      return [x.title, ...x.steps, x.summary].join(' ');
    })
    .join(' ');
const body = entry.body ?? '';
// Reading time for the whole page: the MDX body (with its props and explainers) plus the
// frontmatter prose the page renders (summary, grade rationale, mechanism steps, study findings,
// table notes, the stop strip and fact sheet).
const pageWords =
  wordCount(mdxToPlain(body)) +
  wordCount(propText(body)) +
  wordCount(explainerText(body)) +
  wordCount([
    ...page.summary,
    page.lede ?? '',
    page.glance.main_risk ?? '',
    ...Object.values(page.grade_rationale),
    ...page.mechanism.flatMap((m) => [m.title, m.detail]),
    ...Object.values(page.studies).flatMap((s) => [s.finding, s.limitation]),
    ...Object.values(page.regulatory_notes),
    ...Object.values(page.indications),
    ...(page.glance.stop_signs ?? []).map((s) => s.text),
    ...page.glance.facts.flatMap((f) => [f.label, f.value]),
  ].join(' '));
// The short version: everything outside the folds (the body without its <InDetail> blocks, with
// the words in its props and explainers, plus the lede, summary, fact sheet, stop strip and risk
// tile). Tables, the causal chain, study notes and the grade reasons are folded.
const shortBody = body.replace(/<InDetail\s[\s\S]*?<\/InDetail>/g, ' ');
// The At a glance tiles and the evidence card are fixed strings from i18n (about 150 words).
const BEGINNER_CARDS_WORDS = 150;
const shortWords = hasFolds
  ? BEGINNER_CARDS_WORDS +
    wordCount(mdxToPlain(shortBody)) +
    wordCount(propText(shortBody)) +
    wordCount(explainerText(shortBody)) +
    wordCount([
      ...page.summary,
      page.lede ?? '',
      page.glance.main_risk ?? '',
      ...(page.glance.stop_signs ?? []).map((s) => s.text),
      ...page.glance.facts.flatMap((f) => [f.label, f.value]),
    ].join(' '))
  : 0;
const jsonld = webPage({ locale, key, title: page.title, description: page.description, lastReviewed: data.last_reviewed, reviewedBy: data.reviewed_by, medical: true, article: true, about, trail });
---
<DocLayout
  locale={locale}
  routeKey={key}
  alternates={alternates}
  title={page.title}
  description={page.description}
  eyebrow={t(locale, `vocab.class.${data.class}`)}
  summary={page.summary}
  summaryTitle={t(locale, 'compound.sections.thirty-second')}
  readingMinutes={readingMinutes(pageWords)}
  readingMinutesShort={hasFolds ? readingMinutes(shortWords) : undefined}
  lede={page.lede}
  foldSources={hasFolds}
  template="compound"
  section="compounds"
  lastReviewed={data.last_reviewed}
  reviewedBy={data.reviewed_by}
  editedBy={data.edited_by}
  citations={citations}
  inlineCitations={(rpf.citations ?? []).length}
  terms={rpf.terms ?? []}
  toc={toc}
  trail={trail}
  fallback={fallback}
  translation={page.translation}
  jsonld={fallback ? [] : jsonld}
  noindex={fallback}
  docClass={`compound compound--${data.category} compound--${data.status}`}
>
  <Fragment slot="header">
    <p class="compound-badge" data-category={data.category}>
      <ThemeOnly theme="b c" as="span" class="compound-badge__icon"><Pictogram name={`status-${data.category}`} /></ThemeOnly>
      {t(locale, badgeKey)}
    </p>
  </Fragment>
  <Fragment slot="lead">
    {data.status === 'stub' && <p class="notice notice--stub"><strong>{t(locale, 'common.stub.label')}.</strong> {t(locale, 'common.stub.notice')}</p>}
  </Fragment>
  <Fragment slot="glance">
    <AtAGlance locale={locale} data={data} mainRisk={page.glance.main_risk} hasRisksSection={sectionsPresent.includes('risks')} />
    {page.glance.stop_signs && <StopStrip locale={locale} signs={page.glance.stop_signs} citeIndex={citeIndex} />}
  </Fragment>
  <FactSheet slot="facts" locale={locale} data={data} facts={page.glance.facts} />
  {hasFolds && <ReadingTools slot="tools" locale={locale} />}
  <div class="compound-glance">
    <EvidenceGrade compound={slug} foldWhy={hasFolds} />
    {hasFolds ? (
      <InDetail title={t(locale, 'beginner.technical.fold')} id="technical">
        <SequenceView compound={slug} />
        <dl class="compound-facts">{techFacts.map((f) => <div><dt>{f.label}</dt><dd>{f.qty ? <bdi class:list={['qty', f.formula && 'formula']} set:html={f.value} /> : f.value}</dd></div>)}</dl>
      </InDetail>
    ) : (
      <>
        <SequenceView compound={slug} />
        <section class="compound-tech" id="technical" aria-labelledby="technical-title">
          <h2 class="compound-tech__title" id="technical-title">{t(locale, 'beginner.technical.title')}</h2>
          <dl class="compound-facts">{techFacts.map((f) => <div><dt>{f.label}</dt><dd>{f.qty ? <bdi class:list={['qty', f.formula && 'formula']} set:html={f.value} /> : f.value}</dd></div>)}</dl>
        </section>
      </>
    )}
  </div>
  <Content components={mdxComponents} />
</DocLayout>
