---
import BuiltinPage from '../../layouts/BuiltinPage.astro';
import GlossaryIndex from '../../components/mdx/GlossaryIndex.astro';
import { BUILT_LOCALES } from '../../lib/config';
import { t } from '../../lib/i18n';
export const getStaticPaths = () => BUILT_LOCALES.map((l) => ({ params: { locale: l.code } }));
const { locale } = Astro.params as { locale: string };
Astro.locals.locale = locale;
---
<BuiltinPage locale={locale} routeKey="glossary" title={t(locale, 'pages.glossary.title')} description={t(locale, 'pages.glossary.description')} summary={[t(locale, 'pages.glossary.intro')]} medical reviewedBy="pending-medical-review">
  <GlossaryIndex />
</BuiltinPage>
