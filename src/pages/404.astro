---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUILT_LOCALES, DEFAULT_LOCALE } from '../lib/config';
import { routeUrl } from '../lib/urls';
import { t } from '../lib/i18n';
const L = DEFAULT_LOCALE;
---
<BaseLayout locale={L} title={t(L, 'common.pageNotFound.title')} description={t(L, 'common.pageNotFound.text')} routeKey="" alternates={[]} noindex>
  <article class="doc doc--index">
    <header class="doc-header"><h1 class="doc-header__title">{t(L, 'common.pageNotFound.title')}</h1></header>
    <div class="prose">
      {BUILT_LOCALES.map((l) => (
        <section lang={l.bcp47} dir={l.dir}>
          <p>{t(l.code, 'common.pageNotFound.text')}</p>
          <p><a href={routeUrl(l.code, '')}>{t(l.code, 'common.home')}</a> · <a href={routeUrl(l.code, 'search')}>{t(l.code, 'common.utility.search')}</a></p>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
