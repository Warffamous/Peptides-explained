---
/**
 * Root: language chooser. With JavaScript, readers whose browser prefers a built language go
 * straight there; without it, they choose. No cookies, no server.
 */
import BaseHead from '../components/layout/BaseHead.astro';
import { BUILT_LOCALES, DEFAULT_LOCALE, DEFAULT_THEME } from '../lib/config';
import { routeUrl } from '../lib/urls';
import { t } from '../lib/i18n';
const codes = BUILT_LOCALES.map((l) => l.code);
const redirect = `(function(){try{var c=${JSON.stringify(codes)},h=${JSON.stringify(Object.fromEntries(BUILT_LOCALES.map((l) => [l.code, routeUrl(l.code, '')])))};var p=(navigator.languages||[navigator.language]).map(function(x){return String(x).slice(0,2).toLowerCase()});for(var i=0;i<p.length;i++){if(c.indexOf(p[i])>-1){location.replace(h[p[i]]);return}}location.replace(h[${JSON.stringify(DEFAULT_LOCALE)}])}catch(e){}})()`;
---
<!doctype html>
<html lang="en" dir="ltr" data-theme={DEFAULT_THEME}>
  <head>
    <BaseHead locale={DEFAULT_LOCALE} title={t(DEFAULT_LOCALE, 'pages.root.title')} description={t(DEFAULT_LOCALE, 'common.tagline')} routeKey="" alternates={[]} ogType="website" />
    <script is:inline set:html={redirect} />
  </head>
  <body class="page page--root">
    <main id="main" class="root-chooser">
      <h1>{t(DEFAULT_LOCALE, 'common.brand')}</h1>
      <ul role="list" class="root-chooser__list">
        {BUILT_LOCALES.map((l) => (
          <li><a href={routeUrl(l.code, '')} lang={l.bcp47} dir={l.dir} hreflang={l.hreflang}>{t(l.code, 'pages.root.continue', { language: l.name })}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
