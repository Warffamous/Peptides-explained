---
import BaseHead from '../components/layout/BaseHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import GlossaryDefs from '../components/layout/GlossaryDefs.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { getLocale, PSEUDO_RTL, SOURCE_LOCALE } from '../lib/config';
import { t } from '../lib/i18n';

interface Props {
  locale: string;
  title: string;
  description: string;
  routeKey: string;
  alternates: string[];
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  terms?: string[];
  pageClass?: string;
  ogType?: 'website' | 'article';
  /** The page shows its own "not yet translated, you are reading English" notice: the site-wide preview banner would repeat it. */
  fallback?: boolean;
  /** Id of an element the first paint waits for (BaseHead). */
  renderAfter?: string;
  /** The 404 page (BaseHead: own title, no canonical). */
  notFound?: boolean;
}
const { locale, title, description, routeKey, alternates, noindex, jsonld, terms = [], pageClass, ogType, fallback = false, renderAfter, notFound = false } = Astro.props;
Astro.locals.locale = locale;
const loc = getLocale(locale);
const dir = PSEUDO_RTL ? 'rtl' : loc.dir;
const source = getLocale(SOURCE_LOCALE);
---
<!doctype html>
<html lang={loc.bcp47} dir={dir} data-pseudo={PSEUDO_RTL ? 'rtl' : undefined}>
  <head>
    <BaseHead {locale} {title} {description} {routeKey} {alternates} {noindex} {jsonld} {ogType} {renderAfter} {notFound} />
  </head>
  <body class:list={['page', pageClass]}>
    <a class="skip-link" href="#main">{t(locale, 'common.skipToContent')}</a>
    <div class="site-banners" data-pagefind-ignore="all">
      <ConsentBanner {locale} />
      {loc.status === 'preview' && !fallback && <p class="banner banner--preview">{t(locale, 'common.translation.previewLocale', { language: loc.name })}</p>}
      <p class="banner banner--pseudo">{t(locale, 'common.pseudoRtl')} — <a href="?pseudo=off" lang={source.bcp47}>off</a></p>
    </div>
    <SiteHeader {locale} {routeKey} />
    <div class="site-body">
      <slot name="before-main" />
      <main id="main" class="site-main" tabindex="-1">
        <slot />
      </main>
    </div>
    <SiteFooter {locale} />
    <GlossaryDefs {locale} {terms} />
    <script>
      import '../scripts/glossary-tooltip.ts';
    </script>
  </body>
</html>
