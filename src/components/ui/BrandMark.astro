---
/** The neutral brand mark: three linked residues. Decorative; the name beside it is the label. */
---
<svg class="brand-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
  <path class="brand-mark__bond" d="M8 20 L16 12 L24 20" fill="none" stroke="currentColor" stroke-width="2" />
  <circle class="brand-mark__res" cx="8" cy="20" r="4" />
  <circle class="brand-mark__res brand-mark__res--accent" cx="16" cy="12" r="4" />
  <circle class="brand-mark__res" cx="24" cy="20" r="4" />
</svg>
