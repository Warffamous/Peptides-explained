---
/** Design A: the chain as a technical line drawing — residues as labelled stations on a rule, wrapped every 10. */
import type { Residue } from '../../lib/sequence';
interface Props { residues: Residue[]; seq: { n_terminus: string; c_terminus: string; modifications: { position: number }[]; bridges: { from: number; to: number }[] } }
const { residues, seq } = Astro.props;
const PER = 10, DX = 34, DY = 56, X0 = 40, Y0 = 26;
const rows = Math.ceil(residues.length / PER);
const W = X0 * 2 + (PER - 1) * DX, H = Y0 + rows * DY;
const pos = (i: number) => ({ x: X0 + (i % PER) * DX, y: Y0 + Math.floor(i / PER) * DY });
const modified = new Set(seq.modifications.map((m) => m.position));
---
<svg class="seq-line" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true" focusable="false">
  {Array.from({ length: rows }, (_, r) => {
    const n = Math.min(PER, residues.length - r * PER);
    return <line class="seq-line__rule" x1={X0 - 14} x2={X0 + (n - 1) * DX + 14} y1={Y0 + r * DY} y2={Y0 + r * DY} />;
  })}
  <text class="seq-line__term" x={X0 - 18} y={Y0 + 4} text-anchor="end">{seq.n_terminus}</text>
  {(() => { const p = pos(residues.length - 1); return <text class="seq-line__term" x={p.x + 18} y={p.y + 4}>{seq.c_terminus}</text>; })()}
  {residues.map((r, i) => {
    const p = pos(i);
    return (
      <g class:list={['seq-line__res', `is-${r.cls}`, r.d && 'is-d', modified.has(r.position) && 'is-mod']}>
        <circle cx={p.x} cy={p.y} r="5" />
        <text class="seq-line__code" x={p.x} y={p.y - 11} text-anchor="middle">{r.base}</text>
        {(r.position === 1 || r.position % 5 === 0) && <text class="seq-line__pos" x={p.x} y={p.y + 19} text-anchor="middle">{r.position}</text>}
      </g>
    );
  })}
</svg>
