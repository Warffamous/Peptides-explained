---
/**
 * Markup that belongs to specific design systems (a hero visual, a pictogram row).
 * Dedicated builds omit it entirely when it is not theirs; the switchable build renders it
 * with data-theme-only and each theme's CSS hides the slots that are not its own.
 * Excluded from search so the index never contains the same text three times.
 */
import { BUILD_THEMES } from '../../lib/config';
interface Props { theme: string; as?: string; class?: string }
const { theme, as: Tag = 'div', class: cls } = Astro.props;
const themes = theme.split(/[\s,]+/).filter(Boolean);
const render = themes.some((t) => BUILD_THEMES.includes(t as never));
const needsMarker = BUILD_THEMES.some((t) => !themes.includes(t));
---
{render && (needsMarker
  ? <Tag data-theme-only={themes.join(' ')} data-pagefind-ignore="all" class={cls}><slot /></Tag>
  : <Tag class={cls}><slot /></Tag>)}
