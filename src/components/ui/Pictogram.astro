---
import { PICTOGRAMS, PICTOGRAM_NAMES } from './pictograms';
interface Props { name: string; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;
if (!(PICTOGRAM_NAMES as readonly string[]).includes(name)) throw new Error(`unknown pictogram "${name}"`);
// Drawn inline: a page uses a handful of pictograms (the At a glance tiles, the stop strip, the
// status badge), so this is lighter than shipping the whole vocabulary as a sprite on every page.
---
<svg class:list={['pictogram', `pictogram--${name}`, cls]} viewBox="0 0 48 48" width="48" height="48" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false"><g set:html={PICTOGRAMS[name]} /></svg>
