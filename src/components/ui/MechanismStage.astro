---
/**
 * Design B's scroll-driven mechanism stage. A vertical cell schematic — extracellular space,
 * membrane with receptor, cytoplasm, nucleus, tissue, whole body — on which each causal step
 * appears as a numbered marker in the zone where it happens, joined to the previous step by a link
 * coloured by evidence (cyan = demonstrated, amber = hypothesised).
 *
 * Vertical on purpose: top-to-bottom is direction-neutral, so the stage never needs mirroring in RTL.
 * Without JavaScript (or with reduced motion) it is a complete static still with every step marked;
 * scripts/scroll-mechanism.ts advances it step by step as the reader scrolls the list beside it.
 * Decorative: the ordered list next to it carries the same information as text.
 */
interface Props { steps: { kind: string; level: string }[] }
const { steps } = Astro.props;
const W = 400;
const ZONE_Y: Record<string, number> = { binding: 140, signal: 238, cellular: 336, tissue: 434, effect: 520 };
const perZone = new Map<string, number>();
const totals = new Map<string, number>();
for (const s of steps) totals.set(s.kind, (totals.get(s.kind) ?? 0) + 1);
const markers = steps.map((s, i) => {
  const j = perZone.get(s.kind) ?? 0;
  perZone.set(s.kind, j + 1);
  const n = totals.get(s.kind)!;
  const x = W / 2 + (j - (n - 1) / 2) * 52;
  const y = ZONE_Y[s.kind] ?? 300;
  return { i, x, y, level: s.level, kind: s.kind };
});
const link = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const my = (a.y + b.y) / 2;
  return b.y === a.y
    ? `M ${a.x} ${a.y} Q ${(a.x + b.x) / 2} ${a.y - 34} ${b.x} ${b.y}`
    : `M ${a.x} ${a.y} C ${a.x} ${my} ${b.x} ${my} ${b.x} ${b.y}`;
};
const lipids = Array.from({ length: 19 }, (_, k) => 20 + k * 20).filter((x) => x < 160 || x > 240);
const demonstrated = (lv: string) => lv !== 'hypothesis';
---
<div class="mechanism-stage" aria-hidden="true" data-steps={steps.length}>
  <svg class="stage" viewBox={`0 0 ${W} 560`} width={W} height="560" focusable="false">
    <defs>
      <filter id="stage-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <!-- zones -->
    <g class="stage__zone" data-zone="binding">
      <g class="stage__ligand">
        {[0, 1, 2, 3, 4, 5].map((k) => <circle cx={150 + k * 20} cy={52 + Math.sin(k * 1.3) * 9} r={k % 2 ? 6 : 7.5} />)}
      </g>
      <g class="stage__membrane">
        {lipids.map((x) => <><circle cx={x} cy="124" r="5.5" /><line x1={x} y1="130" x2={x} y2="138" /><circle cx={x} cy="158" r="5.5" /><line x1={x} y1="144" x2={x} y2="152" /></>)}
      </g>
      <path class="stage__receptor" d="M 166 108 v 62 h 9 v -62 h 9 v 62 h 9 v -62 h 9 v 62 h 9 v -62 h 9 v 62 h 9 v -62" fill="none" />
    </g>
    <g class="stage__zone" data-zone="signal">
      <circle class="stage__node" cx="200" cy="212" r="9" />
      <circle class="stage__node" cx="160" cy="262" r="7" />
      <circle class="stage__node" cx="240" cy="262" r="7" />
      <path class="stage__cascade" d="M 200 221 L 162 255 M 200 221 L 238 255" fill="none" />
    </g>
    <g class="stage__zone" data-zone="cellular">
      <ellipse class="stage__nucleus" cx="200" cy="336" rx="78" ry="40" />
      <path class="stage__dna" d="M 150 336 q 12 -12 25 0 t 25 0 t 25 0 t 25 0" fill="none" />
    </g>
    <g class="stage__zone" data-zone="tissue">
      {[[170, 420], [200, 404], [230, 420], [170, 452], [200, 468], [230, 452], [200, 436]].map(([x, y]) => (
        <path class="stage__cell" d={`M ${x} ${y - 15} l 13 7.5 v 15 l -13 7.5 l -13 -7.5 v -15 z`} />
      ))}
    </g>
    <g class="stage__zone" data-zone="effect">
      <circle class="stage__body" cx="200" cy="500" r="9" />
      <path class="stage__body" d="M 184 545 q 0 -30 16 -32 q 16 2 16 32" />
    </g>
    <!-- causal links and step markers -->
    {markers.slice(1).map((m) => (
      <path class:list={['stage__link', demonstrated(m.level) ? 'is-demonstrated' : 'is-hypothesis']} data-step={m.i} data-level={m.level} d={link(markers[m.i - 1], m)} pathLength="1" />
    ))}
    {markers.map((m) => (
      <g class:list={['stage__marker', demonstrated(m.level) ? 'is-demonstrated' : 'is-hypothesis']} data-step={m.i} data-level={m.level} data-kind={m.kind}>
        <circle class="stage__marker-halo" cx={m.x} cy={m.y} r="19" />
        <circle class="stage__marker-dot" cx={m.x} cy={m.y} r="13" />
        <text x={m.x} y={m.y + 4.5} text-anchor="middle">{m.i + 1}</text>
      </g>
    ))}
  </svg>
</div>
