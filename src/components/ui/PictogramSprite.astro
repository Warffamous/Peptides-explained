---
import { PICTOGRAMS } from './pictograms';
---
<svg class="pictogram-sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
  <defs>
    {Object.entries(PICTOGRAMS).map(([name, body]) => <symbol id={`pg-${name}`} viewBox="0 0 48 48" set:html={body} />)}
  </defs>
</svg>
