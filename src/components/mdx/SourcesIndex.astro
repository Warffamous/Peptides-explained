---
/**
 * Every source this locale's pages use (src/lib/content.ts, usedSourceIds), grouped by type. Sources
 * of what the locale does not show (another jurisdiction's rows, timeline and tracker items) stay in
 * the registry for the locale that shows them.
 */
import { t } from '../../lib/i18n';
import { ctxLocale } from '../../lib/ctx';
import { SOURCES } from '../../lib/data';
import { usedSourceIds } from '../../lib/content';
import SourceRef from '../ui/SourceRef.astro';
const L = ctxLocale(Astro);
const used = await usedSourceIds(L);
const ORDER = ['law', 'regulator', 'label', 'guideline', 'trial', 'meta-analysis', 'review', 'article', 'preprint', 'registry', 'report', 'dataset', 'book', 'chapter', 'web'];
const all = [...SOURCES.values()].filter((s) => used.has(s.id));
const byType = ORDER.map((ty) => ({ ty, list: all.filter((s) => s.type === ty).sort((a, b) => (a.authors ?? '').localeCompare(b.authors ?? '') || a.year - b.year) })).filter((g) => g.list.length);
---
<div class="sources-index">
  <p class="sources-index__count">{t(L, 'pages.sources.count', { n: all.length })}</p>
  {byType.map(({ ty, list }) => (
    <section class="sources-index__group" aria-labelledby={`st-${ty}`}>
      <h2 class="sources-index__type" id={`st-${ty}`}>{t(L, `vocab.sourceType.${ty}`)} <span class="sources-index__n">({list.length})</span></h2>
      <ul class="sources-index__list">
        {list.map((s) => <li id={`source-${s.id}`}><SourceRef locale={L} source={s} /></li>)}
      </ul>
    </section>
  ))}
</div>
