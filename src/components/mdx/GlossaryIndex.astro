---
import { t, namespace } from '../../lib/i18n';
import { ctxLocale } from '../../lib/ctx';
import { getLocale } from '../../lib/config';
type Entry = { term: string; definition: string; category: string; see_also?: string[]; aliases?: string[] };
const L = ctxLocale(Astro);
const g = namespace<Record<string, Entry>>(L, 'glossary');
const collator = new Intl.Collator(getLocale(L).dateLocale, { sensitivity: 'base' });
const entries = Object.entries(g).sort(([, a], [, b]) => collator.compare(a.term, b.term));
const letters = [...new Set(entries.map(([, e]) => e.term[0].toLocaleUpperCase(getLocale(L).dateLocale)))];
---
<div class="glossary-index">
  <nav class="glossary-index__letters" aria-label={t(L, 'pages.glossary.jumpTo')}>
    <ul role="list">{letters.map((l) => <li><a href={`#letter-${encodeURIComponent(l)}`}>{l}</a></li>)}</ul>
  </nav>
  {letters.map((letter) => (
    <section class="glossary-index__group" aria-labelledby={`letter-${encodeURIComponent(letter)}`}>
      <h2 class="glossary-index__letter" id={`letter-${encodeURIComponent(letter)}`}>{letter}</h2>
      <dl class="glossary-index__list">
        {entries.filter(([, e]) => e.term[0].toLocaleUpperCase(getLocale(L).dateLocale) === letter).map(([id, e]) => (
          <div class="glossary-index__entry" id={id} data-category={e.category}>
            <dt class="glossary-index__term">{e.term}{e.aliases && e.aliases.length > 0 && <span class="glossary-index__aliases"> ({e.aliases.join(', ')})</span>}</dt>
            <dd class="glossary-index__def">{e.definition}</dd>
            <dd class="glossary-index__cat">{t(L, `pages.glossary.categories.${e.category}`)}</dd>
            {e.see_also && e.see_also.filter((s) => g[s]).length > 0 && (
              <dd class="glossary-index__see">{t(L, 'pages.glossary.seeAlso')}: {e.see_also.filter((s) => g[s]).map((s, i) => <>{i > 0 && ', '}<a href={`#${s}`}>{g[s].term}</a></>)}</dd>
            )}
          </div>
        ))}
      </dl>
    </section>
  ))}
</div>
