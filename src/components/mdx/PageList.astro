---
import { ctxLocale } from '../../lib/ctx';
import { sectionPages } from '../../lib/content';
import { routeUrl } from '../../lib/urls';
import Icon from '../ui/Icon.astro';
interface Props { section: string }
const L = ctxLocale(Astro);
const pages = await sectionPages(L, Astro.props.section);
---
<ul class="page-list" role="list">
  {pages.map(({ key, entry, fallback }) => (
    <li class="page-list__item">
      <a class="page-list__link" href={routeUrl(L, key)} lang={fallback ? 'en' : undefined}>
        <span class="page-list__title">{entry.data.nav_title ?? entry.data.title}</span>
        <Icon name="arrow" />
      </a>
      <p class="page-list__desc" lang={fallback ? 'en' : undefined}>{entry.data.description}</p>
    </li>
  ))}
</ul>
