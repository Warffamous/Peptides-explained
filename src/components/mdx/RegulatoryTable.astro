---
import { t } from '../../lib/i18n';
import { ctxCompound } from '../../lib/ctx';
import { formatDate, isoDate } from '../../lib/format';
import { JURISDICTIONS } from '../../schemas/vocab';
import ThemeOnly from '../ui/ThemeOnly.astro';
import Pictogram from '../ui/Pictogram.astro';
const c = ctxCompound(Astro, 'RegulatoryTable');
const L = c.locale;
const rows = [...c.data.regulatory].sort((a, b) => JURISDICTIONS.indexOf(a.jurisdiction) - JURISDICTIONS.indexOf(b.jurisdiction));
---
<div class="reg-table">
  <div class="table-scroll" tabindex="0" role="region" aria-labelledby="reg-caption">
    <table class="data-table reg-table__table">
      <caption id="reg-caption">{t(L, 'compound.regulatoryTable.caption')}</caption>
      <thead>
        <tr>
          <th scope="col">{t(L, 'compound.regulatoryTable.jurisdiction')}</th>
          <th scope="col">{t(L, 'compound.regulatoryTable.status')}</th>
          <th scope="col">{t(L, 'compound.regulatoryTable.note')}</th>
          <th scope="col">{t(L, 'compound.regulatoryTable.asOf')}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr data-status={r.status} data-jurisdiction={r.jurisdiction}>
            <th scope="row">{t(L, `vocab.jurisdiction.${r.jurisdiction}`)}</th>
            <td data-label={t(L, 'compound.regulatoryTable.status')}>
              <span class="status-badge" data-status={r.status}>
                <ThemeOnly theme="c" as="span" class="status-badge__icon"><Pictogram name={`reg-${r.status}`} /></ThemeOnly>
                {t(L, `vocab.regStatus.${r.status}`)}{r.wada_section && <> · <bdi class="qty">{r.wada_section}</bdi></>}{r.wada_scope && <>, {t(L, `vocab.wadaScope.${r.wada_scope}`)}</>}
              </span>
              {r.since && <span class="reg-table__since">{t(L, 'compound.regulatoryTable.since')} <time datetime={isoDate(r.since)}>{formatDate(L, r.since)}</time></span>}
            </td>
            <td data-label={t(L, 'compound.regulatoryTable.note')} class="reg-table__note">
              {c.page.regulatory_notes[r.jurisdiction]}
              <sup class="cite__marks">{r.sources.map((s, i) => { const n = c.citeIndex.get(s); return n ? <>{i > 0 && ','}<a class="cite__link" href={`#src-${n}`} aria-label={t(L, 'common.cite.label', { n })}>{n}</a></> : null; })}</sup>
            </td>
            <td data-label={t(L, 'compound.regulatoryTable.asOf')}><time datetime={isoDate(r.as_of)}>{formatDate(L, r.as_of)}</time></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
