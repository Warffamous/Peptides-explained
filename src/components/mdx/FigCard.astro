---
/**
 * The data card under a figure (docs/design/DESIGN-DIRECTIONS-2026-10.md §3.2 "Figure anatomy"):
 * where the source, the date it was checked and the evidence level go, so they stop interrupting
 * sentences. Field names are set in sentence case like every other label.
 * Not an MDX component: used inside <KeyNumber>, <IconArray> and <TimeStrip>. `who` is the trial and who
 * took part ("STEP 1: 1,961 adults …"), so a key number's plain label can stay short.
 */
import { t } from '../../lib/i18n';
import { getSource, shortSourceName } from '../../lib/data';
import { formatDate, isoDate } from '../../lib/format';
import type { ClaimLevel } from '../../schemas/vocab';
interface Props { locale: string; source?: string; level?: ClaimLevel; checked?: string; note?: string; who?: string }
const { locale: L, source, level, checked, note, who } = Astro.props;
const names = (source ?? '').split(',').map((s) => s.trim()).filter(Boolean).map((id) => shortSourceName(getSource(id)));
---
<p class="fig__card">
  {note && <span class="fig__field fig__field--note">{note}</span>}
  {who && <span class="fig__field"><span class="fig__key">{t(L, 'figures.who')}</span> {who}</span>}
  {names.length > 0 && (
    <span class="fig__field"><span class="fig__key">{t(L, names.length > 1 ? 'figures.sources' : 'figures.source')}</span> {names.join('; ')}<slot /></span>
  )}
  {checked && <span class="fig__field"><span class="fig__key">{t(L, 'figures.checked')}</span> <time datetime={isoDate(checked)}>{formatDate(L, checked)}</time></span>}
  {level && <span class="fig__field"><span class="fig__key">{t(L, 'figures.evidence')}</span> {t(L, `evidence.claim.levels.${level}.short`)}</span>}
</p>
