---
/**
 * The compound's primary structure, from the data layer. Text first (always LTR, bidi-isolated),
 * with a generated visual per design system: A draws a technical line diagram, B a bead chain
 * derived from the real residues. Every visual is aria-hidden; the text carries the information.
 */
import { t } from '../../lib/i18n';
import { ctxLocale } from '../../lib/ctx';
import { getCompoundData } from '../../lib/content';
import { parseResidues } from '../../lib/sequence';
import ThemeOnly from '../ui/ThemeOnly.astro';
import SequenceLine from '../ui/SequenceLine.astro';
import SequenceBeads from '../ui/SequenceBeads.astro';
interface Props { compound?: string; visual?: boolean }
const L = ctxLocale(Astro);
const slug = Astro.props.compound ?? Astro.locals.compound?.slug;
if (!slug) throw new Error('<SequenceView> needs compound="slug"');
const { visual = true } = Astro.props;
const data = await getCompoundData(slug);
const seq = data.sequence;
const residues = seq ? parseResidues(seq.residues) : [];
---
{seq && (
  <figure class="sequence" aria-labelledby={`seq-${slug}-title`}>
    <figcaption class="sequence__head">
      <span class="sequence__title" id={`seq-${slug}-title`}>{t(L, 'compound.sequence.label')}</span>
      <span class="sequence__length">{t(L, 'compound.names.residuesValue', { n: residues.length })}</span>
    </figcaption>
    {visual && (
      <>
        <ThemeOnly theme="a" class="sequence__visual sequence__visual--line"><SequenceLine residues={residues} seq={seq} /></ThemeOnly>
        <ThemeOnly theme="b" class="sequence__visual sequence__visual--beads"><SequenceBeads residues={residues} seq={seq} slug={slug} locale={L} /></ThemeOnly>
      </>
    )}
    <p class="sequence__text"><bdi class="seq" dir="ltr" translate="no"><span class="sequence__term">{seq.n_terminus}–</span>{seq.display}<span class="sequence__term">–{seq.c_terminus}</span></bdi></p>
    <p class="sequence__read">{t(L, 'compound.sequence.readAs')}</p>
    {(seq.modifications.length > 0 || seq.bridges.length > 0 || residues.some((r) => r.d || r.cls === 'nonstandard')) && (
      <dl class="sequence__notes">
        {seq.modifications.length > 0 && (<div><dt>{t(L, 'compound.sequence.modifications')}</dt>{seq.modifications.map((m) => <dd><bdi class="qty">{t(L, 'compound.sequence.position', { n: m.position })}</bdi>: {m.label}</dd>)}</div>)}
        {seq.bridges.length > 0 && (<div><dt>{t(L, 'compound.sequence.bridges')}</dt>{seq.bridges.map((b) => <dd><bdi class="qty">{b.from}–{b.to}</bdi> ({b.kind})</dd>)}</div>)}
        {residues.some((r) => r.d) && (<div><dt>{t(L, 'compound.sequence.dIsomer')}</dt><dd><bdi class="seq">{residues.filter((r) => r.d).map((r) => `${r.code} (${r.position})`).join(', ')}</bdi></dd></div>)}
        {residues.some((r) => r.cls === 'nonstandard' && !r.d) && (<div><dt>{t(L, 'compound.sequence.nonstandard')}</dt><dd><bdi class="seq">{residues.filter((r) => r.cls === 'nonstandard' && !r.d).map((r) => `${r.code} (${r.position})`).join(', ')}</bdi></dd></div>)}
      </dl>
    )}
  </figure>
)}
