---
/**
 * Reference marker. Numbers are assigned at compile time by remark-citations (attribute n),
 * in order of first appearance; only first occurrences carry the id the source list links back to.
 * A <Cite> on its own line (remark-citations sets block="1") cites the block above it and renders
 * as a small "Sources 3, 46, 7" line instead of a lone superscript.
 */
import { t } from '../../lib/i18n';
import { getSource, shortAuthors } from '../../lib/data';
import { ctxLocale } from '../../lib/ctx';
interface Props { id: string; n?: string; first?: string; block?: string }
const { id, n = '', first = '', block } = Astro.props;
const locale = ctxLocale(Astro);
const ids = id.split(',').map((s) => s.trim());
const nums = n.split(',');
const firsts = first.split(',');
const refs = ids.map((sid, i) => {
  const s = getSource(sid);
  return { n: nums[i], first: firsts[i] === '1', short: `${shortAuthors(s)} (${s.year})`, title: s.title, container: s.container };
});
---
{block === '1' ? (
  <p class="cite-line"><span class="cite-line__key">{t(locale, refs.length > 1 ? 'figures.sources' : 'figures.source')}</span>{' '}<span class="cite"><span class="cite__marks">{refs.map((r, i) => (
    <>{i > 0 && <span class="cite__sep">, </span>}<a class="cite__link" href={`#src-${r.n}`} id={r.first ? `cite-${r.n}` : undefined} aria-label={t(locale, 'common.cite.labelWith', { n: r.n, ref: r.short })}>{r.n}</a></>
  ))}</span></span></p>
) : (
  <span class="cite"><sup class="cite__marks">{refs.map((r, i) => (
    <>{i > 0 && <span class="cite__sep">,</span>}<a class="cite__link" href={`#src-${r.n}`} id={r.first ? `cite-${r.n}` : undefined} aria-label={t(locale, 'common.cite.labelWith', { n: r.n, ref: r.short })}>{r.n}</a></>
  ))}</sup></span>
)}
