---
/**
 * Explainer "glp1-action": how a long-acting GLP-1 receptor agonist (semaglutide) works.
 * Backdrop: text-free AI art (registry art: glp1-action-art, art_dark: glp1-action-art-dark): a brain
 * seen from the side, one blood vessel across the middle, a pancreas and a stomach, as separate
 * specimens. This file is the overlay drawn ON that picture: the moving molecules, the lines, the
 * rings and the per-scene veil, plus every word as an HTML label (docs/EXPLAINERS.md §3.6, rule 8).
 * Anatomy, so it never mirrors in RTL. Coordinates are in a 480 × 480 canvas = the square picture.
 *   1 (k0) circulates bound to albumin                 human
 *   2 (k1) pancreas: more insulin when glucose high     human
 *   3 (k2) pancreas: less glucagon                      human
 *   4 (k3) stomach empties a little more slowly         human
 *   5 (k4) brain hunger areas (animal) → smaller meals (human)
 * Free areas on the picture hold the words: top left (brain, albumin), top right (plate, blood),
 * the band under the vessel (insulin, glucagon) and the bottom margin (pancreas, stomach).
 * Timing (reader test, 20 October 2026): each scene lasts 3 s (duration 15). In every scene the
 * word starts to appear in the first second (fully visible 1.2–2 s in), together with its ring or
 * line, and the moving marks follow,
 * so a reader who pauses anywhere in a scene sees the word for what is strong. The glucagon marks
 * only appear in their own scene (before it they were three unlabelled diamonds in scene 2).
 */
import Overlay from './parts/Overlay.astro';
import { at, link, type Level } from './parts/timeline';
interface Props { uid: string; levels: Level[][]; labels: Record<string, string>; locale: string; backdrop?: { width: number; height: number } }
const { levels: L, labels, locale, backdrop } = Astro.props;
const W = 480;
const H = 480;
if (!backdrop) throw new Error('explainer glp1-action: the overlay needs its picture (art: in src/data/explainers.yaml)');
if (Math.abs(backdrop.width / backdrop.height - W / H) > 0.01) {
  throw new Error(`explainer glp1-action: the picture is ${backdrop.width}×${backdrop.height}, but the overlay is drawn on a ${W}×${H} canvas`);
}
const label = (key: string) => {
  if (!labels[key]) throw new Error(`explainer glp1-action: missing label "${key}" in explainers.json`);
  return labels[key];
};
// A line on the picture: a halo in the page colour under the line itself, on the same timing.
const line = (level: Level, k: number, d: string, lag = 0) => [
  { ...link(level, k, lag), class: 'xp-link xp-halo xp-in', d },
  { ...link(level, k, lag), d },
];
// The veil of a scene: the whole canvas minus the part being talked about (rounded holes, evenodd).
const hole = (x: number, y: number, w: number, h: number, r = 6) =>
  `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
const veil = (...holes: string[]) => `M-4-4H${W + 4}V${H + 4}H-4Z${holes.join('')}`;
const complexes = [34, 108, 196, 322, 440];
const HEX = 'M6.5 0L3.25 5.6H-3.25L-6.5 0L-3.25-5.6H3.25Z';
const DIA = 'M0-6.5L5.6 0L0 6.5L-5.6 0Z';
const P = { w: W, h: H, locale };
---
<svg class="xp-art" viewBox={`0 0 ${W} ${H}`} width={W} height={H} focusable="false">
  <!-- one veil per scene (only while it plays): vessel; band + pancreas; stomach; brain -->
  <path class="xp-veil" d={veil(hole(-2, 194, 484, 46))} style="--k:0" />
  <path class="xp-veil" d={veil(hole(0, 236, 252, 172))} style="--k:1;--span:2" />
  <path class="xp-veil" d={veil(hole(244, 236, 230, 208))} style="--k:3" />
  <path class="xp-veil" d={veil(hole(168, 6, 222, 192))} style="--k:4;--span:2" />

  <!-- 1: semaglutide bound to albumin, carried along the blood vessel -->
  <g class="xp-focus" style="--k:0">
    {complexes.map((x, i) => (
      <g transform={`translate(${x} 219)`}>
        <g class="xp-in xp-flow" style={at(0, 0.15 * i, '--dx:-70px')}>
          <ellipse class="xp-alb" rx="13" ry="9" /><rect class="xp-drug" x="-14" y="-18" width="19" height="7" rx="3.5" /><path class="xp-tail" d="M3-11.5l3 2.5l-2.5 2.5l3 2.5" />
        </g>
      </g>
    ))}
  </g>

  <!-- 2 and 3: the whole pancreas is the scene -->
  <g class="xp-focus" style="--k:1;--span:2">
    <ellipse class="xp-ring xp-halo xp-in" cx="128" cy="356" rx="116" ry="50" style={at(1, 0.2)} />
    <ellipse class="xp-ring xp-in" cx="128" cy="356" rx="116" ry="50" style={at(1, 0.2)} />
  </g>
  <!-- 2: link to the pancreas; insulin rises into the blood ("more insulin") -->
  <g class="xp-focus" style="--k:1">
    {line(L[1][0], 1, 'M40 233C40 266 42 296 44 324').map((a) => <path {...a} />)}
    {/* clear of the "More insulin" label even at 360 px, where the words are larger on the canvas */}
    {[[54, 300], [66, 286], [54, 272]].map(([x, y], i) => (
      <g transform={`translate(${x} ${y})`}><path class="xp-ins xp-in xp-move" d={HEX} style={at(1, 0.7 + 0.3 * i, '--dy:18px')} /></g>
    ))}
  </g>
  <!-- 3: link to the pancreas; glucagon falls (three granules appear with the scene, two leave and
       one stays: "less glucagon"). Before scene 3 none is drawn, so scene 2 shows only insulin.
       The three stand in one column between the line and the "Less glucagon" label, so none is
       covered by the label (at 360 px the words are larger on the canvas and reach x 194–300,
       y 252–300) or sits on the pancreas ring. -->
  <g class="xp-focus" style="--k:2">
    {line(L[2][0], 2, 'M166 233C166 266 168 294 170 322').map((a) => <path {...a} />)}
    <g class="xp-in" style={at(2, 0)}>
      <path class="xp-gcg" transform="translate(182 302)" d={DIA} />
      <path class="xp-gcg xp-out" transform="translate(182 287)" d={DIA} style={at(2, 1.1)} />
      <path class="xp-gcg xp-out" transform="translate(182 272)" d={DIA} style={at(2, 1.6)} />
    </g>
  </g>

  <!-- 4: link to the stomach exit (pylorus); food leaves a little more slowly -->
  <g class="xp-focus" style="--k:3">
    {line(L[3][0], 3, 'M302 233C304 276 300 326 290 370').map((a) => <path {...a} />)}
    <circle class="xp-ring xp-halo xp-in" cx="284" cy="388" r="15" style={at(3, 0.3)} />
    <circle class="xp-ring xp-in" cx="284" cy="388" r="15" style={at(3, 0.3)} />
    {[[258, 398], [248, 401]].map(([x, y], i) => (
      <g transform={`translate(${x} ${y})`}><circle class="xp-food xp-in xp-move" r="3.8" style={at(3, 1 + 0.7 * i, '--dx:12px;--dy:-4px')} /></g>
    ))}
  </g>

  <!-- 5: brain hunger areas (link from animal studies) → smaller meals (shown in people) -->
  <g class="xp-focus" style="--k:4;--span:2">
    {line(L[4][0], 4, 'M288 201C288 190 288 180 288 170').map((a) => <path {...a} />)}
    <ellipse class="xp-ring xp-halo xp-in" data-level={L[4][0]} cx="288" cy="146" rx="30" ry="22" style={at(4, 0.3)} />
    <ellipse class="xp-ring xp-in" data-level={L[4][0]} cx="288" cy="146" rx="30" ry="22" style={at(4, 0.3)} />
    {line(L[4][1] ?? L[4][0], 4, 'M318 138C348 118 378 88 405 66', 0.9).map((a) => <path {...a} />)}
    <circle class="xp-plate" cx="432" cy="58" r="24" />
    <circle class="xp-detail" cx="432" cy="58" r="18" />
    <ellipse class="xp-food xp-shrink" cx="432" cy="58" rx="13" ry="9" style={at(4, 1.4, '--s:0.55')} />
  </g>
</svg>
<Overlay text={label('brain')} x={172} y={50} align="end" focus={4} span={2} {...P} />
<Overlay text={label('hunger')} x={252} y={150} align="end" max={30} tone="note" k={4} lag={0.4} focus={4} span={2} {...P} />
{/* "Smaller meals" is centred a little left of the plate (x 432): C's bold words at 360 px would run past the right edge */}
<Overlay text={label('meals')} x={426} y={90} align="center" max={24} tone="note" k={4} lag={1.1} focus={4} span={2} {...P} />
<Overlay text={label('albumin')} x={8} y={198} valign="bottom" max={28} focus={0} {...P} />
<Overlay text={label('blood')} x={474} y={198} align="end" valign="bottom" focus={0} {...P} />
<Overlay text={label('insulin')} x={74} y={252} max={22} tone="note" k={1} lag={0.4} focus={1} {...P} />
<Overlay text={label('glucagon')} x={194} y={252} max={24} tone="note" k={2} lag={0.3} focus={2} {...P} />
<Overlay text={label('pancreas')} x={16} y={402} focus={1} span={2} {...P} />
<Overlay text={label('stomach')} x={470} y={446} align="end" focus={3} {...P} />
<Overlay text={label('slower')} x={250} y={428} align="end" max={32} tone="note" k={3} lag={0.5} focus={3} {...P} />
