---
/**
 * Design-system switcher. Without JavaScript the links open the dedicated review builds
 * (/a/, /b/, /c/). With JavaScript in the switchable build, they swap the stylesheet in
 * place and remember the choice.
 */
import { SITE, BUILD_THEME, DEFAULT_THEME } from '../../lib/config';
import { themeBuildUrl } from '../../lib/urls';
import { t } from '../../lib/i18n';
import Icon from '../ui/Icon.astro';
interface Props { locale: string; routeKey: string }
const { locale, routeKey } = Astro.props;
---
{SITE.themeSwitcher && (
  <details class="disclosure theme-switch" data-theme-switch>
    <summary class="disclosure__summary">
      {/* The icon shows only in the phone menu, where every row starts with one (structure.css). */}
      <Icon name="layout" class="theme-switch__icon" />
      <span class="theme-switch__label">{t(locale, 'common.utility.design')}</span>
      <span class="theme-switch__current" data-theme-current>{BUILD_THEME === 'switchable' ? DEFAULT_THEME.toUpperCase() : BUILD_THEME.toUpperCase()}</span>
    </summary>
    <ul class="disclosure__panel theme-switch__list" role="list">
      {SITE.themes.map((th) => (
        <li>
          <a href={themeBuildUrl(th, locale, routeKey)} data-theme-option={th} aria-current={(BUILD_THEME === 'switchable' ? DEFAULT_THEME : BUILD_THEME) === th ? 'true' : undefined}>
            {t(locale, `common.utility.designOptions.${th}`)}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}
{BUILD_THEME === 'switchable' && (
  <script>
    const root = document.documentElement;
    const link = document.getElementById('theme-css') as HTMLLinkElement | null;
    const hrefs: Record<string, string> = JSON.parse(link?.dataset.hrefs ?? '{}');
    const sync = (theme: string) => {
      document.querySelectorAll<HTMLAnchorElement>('[data-theme-option]').forEach((a) => {
        if (a.dataset.themeOption === theme) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      document.querySelectorAll('[data-theme-current]').forEach((el) => (el.textContent = theme.toUpperCase()));
    };
    sync(root.dataset.theme ?? 'a');
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-theme-option]');
      const theme = a?.dataset.themeOption;
      if (!a || !link || !theme || !hrefs[theme]) return;
      e.preventDefault();
      link.href = hrefs[theme];
      root.dataset.theme = theme;
      try { localStorage.setItem('pe-theme', theme); } catch { /* storage blocked: still switch for this page */ }
      sync(theme);
      a.closest('details')?.removeAttribute('open');
      document.dispatchEvent(new CustomEvent('pe:themechange', { detail: { theme } }));
    });
  </script>
)}
