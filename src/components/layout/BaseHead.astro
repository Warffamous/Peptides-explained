---
import { SITE, DEFAULT_LOCALE, getLocale } from '../../lib/config';
import { url, canonicalUrl } from '../../lib/urls';
import { bundleSiteCss } from '../../lib/site-css';
import { t } from '../../lib/i18n';

interface Props {
  locale: string;
  title: string;
  description: string;
  routeKey: string;
  /** published locales that have a genuine translation of this route */
  alternates: string[];
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Id of an element the first paint waits for (<link rel="expect" blocking="render">). */
  renderAfter?: string;
  /** The 404 page: its own title, and no canonical or og:url (it has no address of its own). */
  notFound?: boolean;
}
const { locale, title, description, routeKey, alternates, noindex = false, jsonld = [], ogType = 'article', renderAfter, notFound = false } = Astro.props;
const loc = getLocale(locale);
const brand = t(locale, 'common.brand');
const fullTitle = routeKey === '' && !notFound ? `${brand} — ${t(locale, 'common.tagline')}` : `${title} · ${brand}`;
const canonical = canonicalUrl(locale, routeKey);
const robots = noindex || loc.status !== 'published' ? 'noindex, follow' : 'index, follow';

// The site's one stylesheet, content-hashed (src/lib/site-css.ts).
const cssHref = url(`/styles/site.css?v=${bundleSiteCss().hash}`);
// The body face (Outfit, Latin) or, on Arabic-script pages, Noto Sans Arabic.
const preloadFont = loc.script === 'arabic' ? 'noto-sans-arabic-arabic-wght-normal.woff2' : 'outfit-latin-wght-normal.woff2';
// Inline, render-blocking on purpose: applies the stored light/dark choice and ?pseudo=rtl before
// first paint, so there is no flash. Well under 1 KB; everything else is deferred. html.js is set
// first, outside the try: when storage is blocked (access throws) the JS-only controls (scheme
// toggle, explainer Pause/Replay) must still be laid out from the first paint and shown.
// A design choice saved by earlier preview builds ('pe-theme') is removed, and ?theme= is ignored.
const boot = `(function(d,w){d.documentElement.classList.add('js');try{var h=d.documentElement,q=new URLSearchParams(w.location.search),ls=w.localStorage,ss=w.sessionStorage;` +
  `ls.removeItem('pe-theme');var s=ls.getItem('pe-scheme');if(s==='dark'||s==='light')h.dataset.scheme=s;` +
  `var p=q.get('pseudo');if(p==='rtl')ss.setItem('pe-pseudo','rtl');else if(p==='off')ss.removeItem('pe-pseudo');` +
  `if(ss.getItem('pe-pseudo')==='rtl'){h.dir='rtl';h.dataset.pseudo='rtl'}}catch(e){}})(document,window)`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!notFound && <link rel="canonical" href={canonical} />}
{alternates.map((l) => <link rel="alternate" hreflang={getLocale(l).hreflang} href={canonicalUrl(l, routeKey)} />)}
{alternates.includes(DEFAULT_LOCALE) && <link rel="alternate" hreflang="x-default" href={canonicalUrl(DEFAULT_LOCALE, routeKey)} />}
<meta name="color-scheme" content="light dark" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!notFound && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content={loc.bcp47.replace('-', '_')} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="preload" href={url(`/fonts/${preloadFont}`)} as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href={cssHref} />
{/* From 64rem the review line and fact sheet are placed above "At a glance" with CSS order, but come
    after it in the DOM. A browser that paints while the HTML is still arriving would show the page
    top without them and then push "At a glance" down (a layout shift on slow machines). This holds
    the first paint until the page top is complete (Chromium; elsewhere it is ignored). */}
{renderAfter && <link rel="expect" href={`#${renderAfter}`} blocking="render" />}
<script is:inline set:html={boot} />
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<meta name="generator" content={`${SITE.brand} (static)`} />
