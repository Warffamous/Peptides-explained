---
import { t } from '../../lib/i18n';
import { getSource } from '../../lib/data';
import { formatDate } from '../../lib/format';
import SourceRef from '../ui/SourceRef.astro';

/** inline = how many of ids were cited inline (they get a back-link); the rest come from data tables. */
interface Props { locale: string; ids: string[]; inline?: number; further?: string[]; heading?: string; id?: string }
const { locale, ids, further = [], heading = t(locale, 'common.sources'), id = 'sources' } = Astro.props;
const inline = Astro.props.inline ?? ids.length;
const furtherOnly = further.filter((f) => !ids.includes(f));
---
{(ids.length > 0 || furtherOnly.length > 0) && (
  <section class="source-list" id={id} aria-labelledby={`${id}-title`} data-pagefind-ignore>
    <h2 class="source-list__title" id={`${id}-title`}>{heading}</h2>
    {ids.length > 0 && (
      <>
        <p class="source-list__intro">{t(locale, 'common.sourcesIntro')}</p>
        <ol class="source-list__items">
          {ids.map((sid, i) => (
            <li class="source-list__item" id={`src-${i + 1}`}>
              <SourceRef locale={locale} source={getSource(sid)} />
              {i < inline && <a class="source-list__back" href={`#cite-${i + 1}`} aria-label={t(locale, 'common.backToCitation', { n: i + 1 })}>↩</a>}
            </li>
          ))}
        </ol>
      </>
    )}
    {furtherOnly.length > 0 && (
      <>
        <h3 class="source-list__subtitle">{t(locale, 'common.furtherReading')}</h3>
        <ul class="source-list__items source-list__items--further">
          {furtherOnly.map((sid) => <li class="source-list__item"><SourceRef locale={locale} source={getSource(sid)} /></li>)}
        </ul>
      </>
    )}
  </section>
)}
