{
  "name": "peptides-explained",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent, non-commercial, multilingual public-health explainer on therapeutic peptides.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && astro dev",
    "validate": "tsx scripts/validate-content.ts",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "prebuild": "node scripts/sync-fonts.mjs && npm run validate && npm run lint:css",
    "build": "astro build && pagefind --site dist --silent",
    "build:live": "PUBLISHED_ONLY=1 astro build --outDir dist-live && pagefind --site dist-live --silent",
    "build:rtl": "PSEUDO_RTL=1 astro build --outDir dist-rtl",
    "check:commerce": "tsx scripts/check-no-commerce.ts dist",
    "check:html": "tsx scripts/check-html.ts dist",
    "check": "npm run check:commerce && npm run check:html",
    "news": "tsx scripts/fetch-news.ts",
    "media:commons": "tsx scripts/media/fetch-commons.ts",
    "media:generate": "tsx scripts/media/generate-image.ts",
    "media:share-card": "tsx scripts/media/make-share-card.ts",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "astro": "^5.18.2",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "lightningcss": "^1.30.1",
    "mdast-util-to-string": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/node": "^26.6.5",
    "node-html-parser": "^9.0.5",
    "pagefind": "^1.5.2",
    "playwright": "^1.56.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^16.26.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
